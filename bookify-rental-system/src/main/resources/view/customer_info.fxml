            <JFXTextField fx:id="txtPhoneNo" layoutX="34.0" layoutY="306.0" prefHeight="30.0" prefWidth="200.0" promptText="     Phone Number" style="-fx-border-color: Black; -fx-border-width: 1; -fx-border-radius: 4;" unFocusColor="WHITE" />
            <JFXTextField fx:id="txtEmail" layoutX="34.0" layoutY="367.0" prefHeight="30.0" prefWidth="200.0" promptText="     Email" style="-fx-border-color: Black; -fx-border-width: 1; -fx-border-radius: 4;" unFocusColor="WHITE" />
