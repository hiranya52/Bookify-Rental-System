<AnchorPane prefHeight="785.0" prefWidth="887.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="contoller.CustomerInfoController">
    <children>
        <Label layoutX="60.0" layoutY="76.0" text="Customers" textFill="#212845">
